option "title" "favai Example"
option "operating_currency" "CNY"

include "./sub_file.beancount"

2026-01-01 custom "fava-extension" "favai" "{'api': 'openai-completions', 'base_url': 'https://api.deepseek.com', 'model': 'deepseek-v4-flash', 'api_key': '$DEEPSEEK_TOKEN', 'vision': False, 'context_window': 256000, 'max_tokens': 16384}"

